generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  password_hash         String
  first_name            String
  last_name             String
  role                  Role                 @default(USER)
  stripe_customer_id    String?              @unique
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  deleted_at            DateTime?
  /// Date à laquelle un code envoyé à cette adresse a été validé, donc preuve que
  /// la boîte existe et appartient à la personne. Distincte de « a ouvert une
  /// session » depuis que la toute première connexion se passe du code : sans cette
  /// colonne, les deux se confondraient et l'entonnoir ne saurait plus dire lequel
  /// des deux murs coûte des comptes.
  email_verifie_le      DateTime?
  /// Faux quand la personne a demandé à ne plus recevoir de relances. Ne concerne
  /// que celles-ci : un code de connexion et un lien de réinitialisation partent
  /// toujours, ils répondent à un geste qu'elle vient de faire.
  relances_email        Boolean              @default(true)
  ai_profile            AIProfile?
  audit_logs            AuditLog[]
  calendar_events       CalendarEvent[]
  daily_progress        DailyProgress[]
  goals                 Goal[]
  habits                Habit[]
  payments              Payment[]
  refresh_tokens        RefreshToken[]
  routines              Routine[]
  subscription          Subscription?
  sync_data             SyncData?
  achievements          UserAchievement[]
  push_subscriptions    PushSubscription[]
  two_factor_codes      TwoFactorCode[]
  chat_messages         ChatMessage[]
  password_reset_tokens PasswordResetToken[]
  ai_usages             AiUsage[]
  coach_echecs          CoachEchec[]
  rappels               Rappel[]
  coin_claims           CoinClaim[]
  push_permissions      PushPermission[]
  offer_prompt          OfferPrompt?
  coup_de_pouce         CoupDePouce?
  relances              RelanceEmail[]
  ouvertures            AppOuverture[]
  signalements_ia       SignalementIA[]
  /// D'ou vient cette inscription : la valeur du parametre `?s=` du lien suivi.
  ///
  /// Rien ne la captait avant le 17 aout 2026, si bien qu'aucune inscription
  /// n'etait attribuable : une soiree a treize arrivees ne disait pas laquelle des
  /// publications les avait fait venir, donc laquelle refaire. `null` sur tous les
  /// comptes anterieurs, et sur quiconque arrive par un lien nu.
  ///
  /// Ecrite par le navigateur, donc falsifiable — sans consequence, elle n'ouvre
  /// aucun acces et ne sert qu'a compter. Normalisee cote serveur.
  source                String?
}

/// Combien de fois l'application est ouverte, et quels jours.
///
/// Rien ne le mesurait : `daily_scores` ne porte une clé que les jours où il s'est
/// passé quelque chose, et `SyncData.updated_at` ne retient que la dernière
/// écriture. On savait donc qui agissait, jamais qui venait regarder sans rien
/// faire — or l'écart entre les deux est précisément ce qui distingue une
/// application consultée d'une application utilisée.
///
/// **Agrégé par jour, pas une ligne par ouverture.** Une table d'événements
/// répondrait à plus de questions, mais elle grandit sans borne pour un chiffre
/// qu'on lit par journée de toute façon. Ici le nombre de lignes est borné par
/// comptes × jours, et l'incrément tient dans un seul upsert.
///
/// Le jour est une clé `YYYY-MM-DD` **heure de Paris**, comme partout ailleurs
/// dans l'administration — voir `common/jour-paris.ts`.
model AppOuverture {
  id       String   @id @default(uuid())
  user_id  String
  jour     String
  nombre   Int      @default(1)
  /// Première et dernière ouverture de la journée. Deux instants plutôt qu'un
  /// seul : leur écart dit si la journée a été une visite ou une présence.
  premiere DateTime @default(now())
  derniere DateTime @updatedAt
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, jour])
  @@index([jour])
}

/// Ce qui a déjà été envoyé à quelqu'un, pour ne pas le lui renvoyer.
///
/// Une relance décidée d'après l'état du compte se redéclencherait tous les jours
/// tant que l'état ne change pas : quelqu'un qui ne revient pas recevrait le même
/// e-mail chaque matin, ce qui est la meilleure façon de se faire marquer comme
/// indésirable — pour tout le domaine, y compris les codes de connexion.
model RelanceEmail {
  id        String   @id @default(uuid())
  user_id   String
  /// jamais_ouvert | decroche
  motif     String
  envoye_le DateTime @default(now())
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, motif])
  @@index([envoye_le])
}

/// Ce que le navigateur a répondu à la demande de notifications, par appareil.
///
/// Sans cette table, un refus ne laisse aucune trace : le code sortait sur un
/// `console.warn` que personne ne lit. On a découvert que 26 comptes sur 28 étaient
/// injoignables par le décompte d'une tournée d'envoi, par accident. Savoir combien
/// refusent, combien ne sont jamais sollicités et combien en sont techniquement
/// incapables est la seule façon de piloter ça autrement qu'à l'intuition.
model PushPermission {
  id         String   @id @default(uuid())
  user_id    String
  /// Même identifiant stable que PushSubscription.device_id.
  device_id  String
  /// accorde | refuse | non_supporte | ios_a_installer | reporte
  etat       String
  /// User-agent réduit à l'essentiel, pour distinguer un iPhone d'un Firefox.
  plateforme String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_id])
  @@index([etat])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  is_revoked Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model AIProfile {
  id                  String    @id @default(uuid())
  user_id             String    @unique
  age                 Int?
  occupation          String?
  objectives          String[]
  constraints         String[]
  current_habits      String[]
  personality         String?
  coaching_style      String?
  /// Ce que la personne raconte d'elle en texte libre a l'inscription : horaires,
  /// blessure, materiel, contexte. C'est le seul champ ou elle peut dire quelque
  /// chose qu'aucun bouton ne prevoyait, et donc le plus utile au coach : sans lui,
  /// le profil se resume a trois reponses parmi quarante-huit combinaisons possibles,
  /// et tout le monde recoit le meme plan.
  situation           String?
  /// Minutes par jour qu'elle dit pouvoir y consacrer. Borne le volume du plan : un
  /// programme de deux heures propose a quelqu'un qui en a vingt minutes n'est pas
  /// ambitieux, il est abandonne des le premier jour.
  minutes_par_jour    Int?
  /// L'heure a laquelle la personne dit se lever, « HH:MM » en heure de Paris.
  ///
  /// Le brief du matin partait a 10 h pour tout le monde. C'est tard pour qui se
  /// leve a 6 h, et l'app ne pouvait donc pas « inciter a se lever » — elle arrivait
  /// quatre heures apres. Avancer l'heure pour tous etait exclu : une notification a
  /// 7 h chez quelqu'un qui dort fait couper les notifications, et **un refus du
  /// navigateur ne se redemande jamais**. D'ou un reglage par personne.
  ///
  /// Nul = 10 h, exactement le comportement d'avant. Personne n'a a repondre a une
  /// question pour continuer a recevoir ce qu'il recevait deja.
  reveil              String?
  /// Point de depart physique declare. Decide des exercices : on ne prescrit pas
  /// quatre series de douze pompes a quelqu'un qui se declare sedentaire.
  niveau_depart       String?
  /// Note de synthese sur la personne, recompressee periodiquement a partir des
  /// anciens echanges. L'historique brut est plafonne : sans ce resume, tout ce qui
  /// depasse la fenetre est definitivement oublie.
  memory_summary      String?
  memory_updated_at   DateTime?
  /// Phrase d'ouverture du coach, celle qu'il dit avant qu'on lui ait rien demande.
  /// Mise en cache parce qu'elle coute un appel au modele : sans cache, recharger la
  /// page en rappellerait un a chaque fois. Regeneree quand elle date de plus de
  /// quelques heures, sinon elle parlerait du matin a quelqu'un qui ouvre le soir.
  ouverture_texte     String?
  ouverture_genere_le DateTime?
  /// La lecture de la semaine ecoulee, ecrite par le coach pour les abonnes.
  ///
  /// Mise en cache pour la meme raison que l'ouverture, en plus fort : c'est un
  /// texte long, il coute davantage, et il ne change qu'une fois par jour au plus.
  /// Sans cache, chaque passage sur le tableau de bord rappellerait le modele.
  ///
  /// `bilan_semaine` retient `version:JOUR` — le jour ou s'arrete la fenetre
  /// commentee (heure de Paris), precede de la version des regles qui ont ecrit le
  /// texte. Le nom de la colonne est historique, la valeur n'est pas une semaine.
  ///
  /// La version sert a rattraper les textes deja ecrits quand la facon de les
  /// ecrire est corrigee : sans elle, un defaut visible reste affiche jusqu'au
  /// lendemain chez ceux qui ont deja leur lecture. Voir `BilanHebdoService`.
  /// Les valeurs sans prefixe datent d'avant le 17 aout 2026 et ne correspondent
  /// plus jamais, ce qui est l'effet recherche.
  ///
  /// Le repere est journalier parce que la fenetre est glissante : le bilan porte
  /// sur les sept derniers jours, pas sur la semaine du lundi au dimanche. Date par
  /// semaine calendaire, une lecture resterait affichee jusqu'a six jours pendant
  /// que les chiffres qu'elle commente auraient entierement change.
  bilan_texte         String?
  bilan_genere_le     DateTime?
  bilan_semaine       String?

  /// La lecture longue reservee aux abonnes : ce que le coach a compris de la
  /// personne, et non de sa semaine. Meme mecanique de cache que `bilan_*`, et
  /// pour la meme raison — sans elle, chaque ouverture du tableau de bord
  /// paierait un appel au modele.
  ///
  /// `analyse_repere` retient `version:JOUR`. La version rattrape les textes
  /// deja ecrits quand la facon de les ecrire change ; le jour suffit comme
  /// fraicheur, l'historique d'une personne ne bouge pas plus vite que ca.
  analyse_texte       String?
  analyse_genere_le   DateTime?
  analyse_repere      String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(uuid())
  user_id              String    @unique
  stripe_sub_id        String?   @unique
  status               SubStatus @default(INACTIVE)
  plan_type            PlanType  @default(FREE_TRIAL)
  current_period_start DateTime?
  current_period_end   DateTime?
  cancel_at_period_end Boolean   @default(false)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  user                 User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Payment {
  id               String   @id @default(uuid())
  user_id          String
  stripe_charge_id String   @unique
  amount           Int
  currency         String   @default("eur")
  status           String
  receipt_url      String?
  created_at       DateTime @default(now())
  user             User     @relation(fields: [user_id], references: [id])
}

model Goal {
  id          String   @id @default(uuid())
  user_id     String
  title       String
  description String?
  category    String
  timeframe   String
  status      String   @default("IN_PROGRESS")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Habit {
  id          String   @id @default(uuid())
  user_id     String
  name        String
  description String?
  frequency   String
  time_of_day String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Routine {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  date       DateTime @db.Date
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@unique([user_id, type, date])
}

model Task {
  id          String    @id @default(uuid())
  routine_id  String
  title       String
  description String?
  duration    Int
  start_time  DateTime?
  end_time    DateTime?
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  difficulty  String    @default("NORMAL")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  routine     Routine   @relation(fields: [routine_id], references: [id], onDelete: Cascade)
}

model DailyProgress {
  id               String   @id @default(uuid())
  user_id          String
  date             DateTime @db.Date
  discipline_score Int      @default(0)
  tasks_completed  Int      @default(0)
  tasks_missed     Int      @default(0)
  current_streak   Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
}

model CalendarEvent {
  id              String   @id @default(uuid())
  user_id         String
  google_event_id String   @unique
  title           String
  start_time      DateTime
  end_time        DateTime
  is_synced       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String            @id @default(uuid())
  name        String
  description String
  icon_url    String?
  points      Int               @default(0)
  users       UserAchievement[]
}

model UserAchievement {
  user_id        String
  achievement_id String
  unlocked_at    DateTime    @default(now())
  achievement    Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, achievement_id])
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  ip_address String?
  user_agent String?
  details    Json?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id])
}

model SyncData {
  id                String    @id @default(uuid())
  user_id           String    @unique
  routines          Json?
  micro_objectives  Json?
  macro_objectives  Json?
  habits            Json?
  nutrition         Json?
  points            Int       @default(0)
  /// Expérience cumulée, qui décide du niveau et du rang. Distincte de `points` :
  /// ceux-ci sont la monnaie de la Boutique et redescendent à chaque achat, ce qui
  /// faisait rétrograder de rang quiconque s'achetait un cosmétique. L'XP, elle, ne
  /// baisse que si un gain est annulé (une tâche décochée). Nullable : les comptes
  /// antérieurs la reçoivent au premier envoi, initialisée à leur solde de points.
  xp                Int?
  /// Solde de coins faisant foi pour l'IA. Jamais alimenté par la synchro : le
  /// client peut y écrire ce qu'il veut, c'est justement ce qu'on corrige.
  ai_credits        Int?
  mental_score      Int       @default(0)
  bonus_score       Int       @default(0)
  daily_scores      Json?
  last_routine_date String?
  last_habit_date   String?
  join_date         String?
  settings          Json?
  rewards           Json?
  inventory         Json?
  owned_cosmetics   Json?
  ai_skin_id        String?
  updated_at        DateTime  @updatedAt
  /// Le jeton de version de l'ETAT synchronise, et lui seul.
  ///
  /// Distinct d'`updated_at`, qui bouge des que **n'importe quoi** touche cette
  /// ligne — or `CoinLedgerService` y ecrit `ai_credits` a chaque routine cochee
  /// et a chaque message au coach. Le client, lui, renvoie le dernier jeton connu
  /// pour prouver sur quelle version il a travaille : un credit de coins suffisait
  /// donc a le perimer, le serveur repondait 409, et l'application declarait un
  /// conflit **contre elle-meme**. Elle mettait alors le travail local de cote et
  /// adoptait la version du serveur — les cases cochees disparaissaient.
  ///
  /// `ai_credits` n'est pas dans l'etat synchronise : les deux ensembles de champs
  /// sont disjoints, une ecriture de coins ne peut donc pas entrer en conflit avec
  /// une remontee. Le jeton ne doit bouger que quand /sync/state ecrit.
  ///
  /// `null` sur les lignes anterieures : la premiere remontee est alors acceptee
  /// sans comparaison, comme une base_version absente.
  etat_version      DateTime?
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

enum SubStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PlanType {
  FREE_TRIAL
  BASIC
  ELITE
}

model PushSubscription {
  id         String   @id @default(uuid())
  user_id    String
  endpoint   String   @unique
  /// Identifiant stable du navigateur, généré côté client. L'endpoint change dès que
  /// le navigateur recrée son abonnement (mise à jour du service worker, données
  /// effacées) : sans repère stable, l'ancienne ligne survit et le même appareil
  /// reçoit la notification en double.
  device_id  String?
  p256dh     String
  auth       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, device_id])
}

model TwoFactorCode {
  id         String   @id @default(uuid())
  user_id    String
  code       String
  expires_at DateTime
  is_used    Boolean  @default(false)
  created_at DateTime @default(now())
  /// Essais ratés sur ce code. Au-delà de `AuthService.ESSAIS_MAX_2FA`, il est
  /// brûlé et il faut en redemander un.
  ///
  /// Le décompte par adresse IP ne suffit pas ici : il borne un appelant, pas un
  /// code. Six chiffres font 900 000 possibilités, mais cinq essais par minute
  /// **et par adresse** deviennent des dizaines de milliers d'essais pendant les
  /// dix minutes de validité dès qu'on dispose de quelques milliers d'adresses —
  /// ce qui se loue. Compté sur le code, le plafond ne dépend plus de l'endroit
  /// d'où l'on frappe.
  tentatives Int      @default(0)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  is_used    Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/// Crédits gagnés, un par action validée. La clé d'événement rend la demande
/// idempotente : rejouer la même requête ne crédite pas deux fois.
model CoinClaim {
  id         String   @id @default(uuid())
  user_id    String
  event_key  String
  amount     Int
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_key])
  @@index([user_id, created_at])
}

/// Consommation d'IA facturable, comptée explicitement plutôt que déduite des
/// ChatMessage : le quota ne doit pas dépendre de la façon dont le service IA
/// persiste ses données.
model AiUsage {
  id         String   @id @default(uuid())
  user_id    String
  kind       String // "chat" | "routines"
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

/// Un message auquel le coach n'a pas repondu, et pourquoi.
///
/// L'echec ne laissait qu'un console.error sur l'hebergeur — c'est-a-dire rien,
/// puisque personne ne lit ces journaux le lendemain. Le tableau d'administration
/// savait donc compter les silences (lignes `user` moins lignes `ai`) sans jamais
/// pouvoir en nommer la cause : saturation, delai depasse, cle refusee et reponse
/// vide se soignent pourtant de quatre facons differentes.
///
/// Seuls le code et le dernier modele essaye sont conserves. Ni l'invite ni le
/// corps d'erreur du fournisseur : le premier est intime, le second peut recopier
/// n'importe quoi de la requete. Un diagnostic n'a pas besoin de les relire.
/// Un rappel demande au coach, et qui doit vraiment arriver.
///
/// Le coach repondait « Rappel : 22 h 30 - commence la premiere tache » et il ne
/// se passait rien : aucune table, aucune tache planifiee, aucune notification.
/// La promesse etait parfaitement credible et entierement fausse — la pire forme
/// de panne muette, parce que c'est l'utilisateur qui la decouvre, a l'heure ou
/// il comptait dessus.
///
/// `envoye_le` est ecrit apres l'envoi, jamais avant : une ligne marquee envoyee
/// alors que le push a echoue condamne le rappel au silence en donnant a croire
/// qu'il est parti. Meme regle que les relances par e-mail.
model Rappel {
  id         String    @id @default(uuid())
  user_id    String
  /// Ce que la personne doit lire a l'heure dite. Ecrit par le coach.
  texte      String
  /// L'instant vise, en UTC. L'heure de Paris est convertie a la creation.
  quand      DateTime
  envoye_le  DateTime?
  /// Annule par la personne. Garde plutot que supprime : « je t'avais mis un
  /// rappel, tu l'as retire » est une chose que le coach doit pouvoir dire.
  annule_le  DateTime?
  cree_le    DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// La tournee cherche les rappels dus et jamais envoyes : c'est cet index-la
  /// qui evite de parcourir toute la table toutes les cinq minutes.
  @@index([envoye_le, quand])
  @@index([user_id, quand])
}

model CoachEchec {
  id         String   @id @default(uuid())
  user_id    String
  /// GROQ_RATE_LIMIT, GROQ_TIMEOUT, GROQ_AUTH, GROQ_MODELE_INCONNU, VIDE, INCONNU...
  code       String
  /// Le dernier maillon essaye. Nul quand la chaine n'a meme pas demarre.
  modele     String?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([created_at])
}

model ChatMessage {
  id         String   @id @default(uuid())
  user_id    String
  sender     String // "user" or "ai"
  text       String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
}

/// Mémoire des relances vers l'abonnement.
///
/// Sans elle, la cadence ne peut vivre que dans le localStorage du navigateur —
/// c'est-à-dire nulle part : un second appareil, un vidage de cache ou une session
/// ouverte ailleurs remettrait le compteur à zéro et la même personne recevrait la
/// même sollicitation indéfiniment. C'est exactement ce qui transforme une relance
/// en harcèlement.
///
/// Une seule ligne par personne : les paliers sont ordonnés et ne se parcourent que
/// vers l'avant, donc le dernier atteint résume tout l'historique. Les compteurs
/// séparent « a vu » de « a repoussé » et de « a ouvert l'offre » — sans quoi une
/// relance qui ne convertit jamais est indiscernable d'une relance jamais affichée,
/// et les deux appellent des corrections opposées.
/// Mémoire des coups de pouce, c'est-à-dire des notifications hors programme que
/// le coach envoie en journée.
///
/// Sans elle, la règle « au plus un tous les trois jours » ne vivrait qu'en
/// mémoire du serveur : un redéploiement Render — il y en a plusieurs par jour —
/// remettrait le compteur à zéro et la même personne recevrait un coup de pouce
/// quotidien. C'est précisément ce qui fait couper les notifications, et un refus
/// navigateur ne se redemande jamais.
///
/// Une seule ligne par personne : seul le dernier envoi décide du prochain. La
/// raison est conservée pour ne pas resservir deux fois de suite le même angle, et
/// le compteur pour savoir, plus tard, si ces messages servent à quelque chose.
model CoupDePouce {
  id              String   @id @default(uuid())
  user_id         String   @unique
  /// Dernier envoi effectif, base du délai minimum entre deux coups de pouce.
  dernier_envoi   DateTime @default(now())
  /// Situation qui l'a déclenché : reprise | aFinir | serie
  derniere_raison String
  envoyes         Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model OfferPrompt {
  id             String   @id @default(uuid())
  user_id        String   @unique
  /// Dernier palier atteint : j3 | j7 | j21 | recurrent
  dernier_palier String
  /// Dernier affichage effectif, base du délai minimum entre deux relances.
  derniere_vue   DateTime @default(now())
  vues           Int      @default(0)
  reports        Int      @default(0)
  ouvertures     Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([dernier_palier])
}

/// Signalement d'une réponse du coach jugée choquante, fausse ou dangereuse.
///
/// Apple exige, pour toute application où une IA écrit du texte lu par des gens,
/// un moyen de signaler ce qu'elle produit — l'absence de ce mécanisme est un
/// motif de rejet à elle seule. Mais l'intérêt n'est pas d'abord réglementaire :
/// c'est le seul canal par lequel on apprend qu'un modèle a dérapé. Sans lui, une
/// mauvaise réponse est vue par une personne, une seule fois, et personne d'autre
/// ne le saura jamais.
///
/// Le texte signalé est copié ici : l'historique du chat vit dans le navigateur et
/// se remet à zéro chaque jour, donc l'appelant ne pourrait plus le retrouver.
model SignalementIA {
  id      String   @id @default(uuid())
  user_id String
  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// La réponse du coach, telle qu'elle a été lue.
  message String
  /// Ce que la personne en dit, si elle a pris la peine de l'écrire.
  motif   String?
  traite  Boolean  @default(false)
  cree_le DateTime @default(now())

  @@index([cree_le])
}
