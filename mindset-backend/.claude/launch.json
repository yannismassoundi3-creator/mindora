{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mindset-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev"],
      "port": 3002
    },
    {
      "name": "mindset-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../mindset-dashboard", "run", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "mindset-dashboard-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../mindset-dashboard", "run", "preview", "--", "--port", "4173"],
      "port": 4173,
      "autoPort": true
    }
  ]
}
